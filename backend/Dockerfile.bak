FROM alpine:3.22
RUN apk add --no-cache php84 php84-pdo_mysql php84-session php84-ctype php84-openssl
WORKDIR /app
COPY --chown=nobody:nobody . .
USER nobody
EXPOSE 8000
CMD ["php84", "-d", "session.save_path=/tmp", "-d", "display_errors=0", "-S", "0.0.0.0:8000", "-t", "public", "public/index.php"]
